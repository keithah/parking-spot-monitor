# Copy this file to .env and replace the placeholders locally.
# Docker Compose reads .env automatically. Never commit the populated file.
RTSP_URL=replace-with-primary-camera-stream
RTSP_URL_4K=replace-with-high-resolution-camera-stream
# Optional unless config.yaml defines a profile that uses RTSP_URL_360P.
RTSP_URL_360P=
MATRIX_ACCESS_TOKEN=replace-with-matrix-access-token
# Host directory containing trusted detector weights, mounted read-only at /models.
MODEL_DIR=./models
